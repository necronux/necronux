amends "pkl:Project"

package {
  name = "Necronux"
  baseUri = "package://pkg.nayanpatil.space/necronux/\(name)"
  version = "0.1.0"
  packageZipUrl = "https://github.com/NayanTheSpaceGuy/necronux/releases/download/\(name)@\(version)/\(name)@\(version).zip"
  description = "The Necronux standard library."
  authors {
    "Nayan (NayanTheSpaceGuy) <nayantsg@proton.me>"
  }
  sourceCode = "https://github.com/NayanTheSpaceGuy/necronux/tree/\(name)@\(version)/packages/\(name)"
  sourceCodeUrlScheme = "https://github.com/NayanTheSpaceGuy/necronux/blob/\(name)@\(version)/packages/\(name)%{path}#L%{line}-%{endLine}"
  issueTracker = "https://github.com/NayanTheSpaceGuy/necronux/issues"
}
