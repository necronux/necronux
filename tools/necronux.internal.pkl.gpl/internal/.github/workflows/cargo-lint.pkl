@ModuleInfo { minPklVersion = "0.27.0" }

amends "../../../../commons/GitHubAction.pkl"

headercomment = """
# ==----------------------------------------------------------------== #
# SPDX-FileCopyrightText: © 2024-2025 Nayan Patil <nayantsg@proton.me>
#
# SPDX-License-Identifier: GPL-3.0-or-later
# ==----------------------------------------------------------------== #
"""

name = "Cargo Lint"

on {
  workflow_dispatch {}
  pull_request {
    branches {
      "develop"
      "stable"
    }
    paths {
      "Cargo.toml"
      "Cargo.lock"
      "crates/**"
    }
  }
}

env {
  ["CARGO_TERM_COLOR"] = "always"
}

jobs {
  ["clippy"] {
    name = "Lint"
    `runs-on` = "ubuntu-latest"
    steps {
      new {
        name = "Checkout code"
        uses = "actions/checkout@v4"
      }
      new {
        name = "Setup Rust env"
        uses = "./.github/actions/setup-rust-env"
      }
      new {
        name = "Run cargo clippy"
        run = "cargo clippy -- -Dclippy::all -D warnings"
      }
    }
  }
  ["rustfmt"] {
    name = "Format"
    `runs-on` = "ubuntu-latest"
    steps {
      new {
        name = "Checkout code"
        uses = "actions/checkout@v4"
      }
      new {
        name = "Setup Rust env"
        uses = "./.github/actions/setup-rust-env"
      }
      new {
        name = "Run cargo fmt"
        run = "cargo fmt --check"
      }
    }
  }
}
