@ModuleInfo { minPklVersion = "0.27.0" }

amends "../../../../commons/GitHubAction.pkl"

headercomment = """
# ==-----------------------------------------------------------== #
# SPDX-FileCopyrightText: © 2025 Nayan Patil <nayantsg@proton.me>
#
# SPDX-License-Identifier: GPL-3.0-or-later
# ==-----------------------------------------------------------== #
"""

name = "Cargo Build Check"

on {
  workflow_dispatch {}
  push {
    branches {
      "develop"
      "stable"
    }
    paths {
      "Cargo.toml"
      "Cargo.lock"
      "crates/**"
    }
  }
  pull_request {
    branches {
      "develop"
      "stable"
    }
    paths {
      "Cargo.toml"
      "Cargo.lock"
      "crates/**"
    }
  }
}

env {
  ["CARGO_TERM_COLOR"] = "always"
}

jobs {
  ["debug-build"] {
    name = "Debug Build"
    `runs-on` = "ubuntu-latest"
    steps {
      new {
        name = "Checkout code"
        uses = "actions/checkout@v4"
      }
      new {
        name = "Setup Rust env"
        uses = "./.github/actions/setup-rust-env"
      }
      new {
        name = "Run cargo build"
        run = "cargo build"
      }
    }
  }
  ["release-build"] {
    name = "Release Build"
    `runs-on` = "ubuntu-latest"
    steps {
      new {
        name = "Checkout code"
        uses = "actions/checkout@v4"
      }
      new {
        name = "Setup Rust env"
        uses = "./.github/actions/setup-rust-env"
      }
      new {
        name = "Run cargo build --release"
        run = "cargo build --release"
      }
    }
  }
}
