@ModuleInfo { minPklVersion = "0.27.0" }

amends "../../../../commons/GitHubAction.pkl"

import "commons/commonJobs.pkl" as commonJobs
import "commons/commonSteps.pkl" as commonSteps
import "commons/commonStepsRust.pkl" as commonStepsRust

headercomment = """
# ==----------------------------------------------------------------== #
# SPDX-FileCopyrightText: © 2024-2025 Nayan Patil <nayantsg@proton.me>
#
# SPDX-License-Identifier: GPL-3.0-or-later
# ==----------------------------------------------------------------== #
"""

name = "CI-Rust"

on {
  pull_request {
    branches {
      "develop"
      "stable"
      "release"
      "hotfix"
    }
    paths {
      "*.rs"
      "**/*.rs"
      "src/**"
      "crates/**"
      "Cargo.toml"
      "Cargo.lock"
      "deny.toml"
    }
  }
  push {
    paths =(on.pull_request.paths) {}
  }
  workflow_dispatch {}
}

env {
  ["CARGO_INCREMENTAL"] = 0
  ["CARGO_NET_RETRY"] = 10
  ["CARGO_TERM_COLOR"] = "always"
  ["RUST_BACKTRACE"] = 1
  ["RUSTFLAGS"] = "-D warnings"
  ["RUSTUP_MAX_RETRIES"] = 10
  ["CARGO_HACK_DENY_WARNINGS"] = 1
}

concurrency {
  group = "${{ github.workflow }}-${{ github.event.pull_request.number || github.ref }}"
  `cancel-in-progress` = true
}

permissions {
  contents = "read"
}

jobs {
  ["conclusion-pr"] = (commonJobs.jobs["conclusion-pr"]) {
    needs = (jobs["conclusion-push"].needs) {}
  }
  ["conclusion-push"] = (commonJobs.jobs["conclusion-push"]) {
    needs {
      "check-version-bump"
      "clippy"
      "lockfile"
      "msrv"
      "rustfmt"
    }
  }

  ["rustfmt"] {
    name = "Rustfmt"
    `runs-on` = "ubuntu-latest"
    `timeout-minutes` = 30
    steps {
      (commonSteps.jobs["checkoutStep"].steps[0]) {}
      (commonStepsRust.jobs["setupRustToolchainStep"].steps[0]) {
        with {
          ["toolchain"] = "stable"
          ["components"] = "rustfmt"
        }
      }
      new {
        name = "Run cargo fmt"
        run = "cargo fmt --all --check"
        shell = "bash"
      }
    }
  }
  ["clippy"] {
    name = "Clippy"
    strategy {
      `fail-fast` = false
      matrix {
        ["os"] {
          "ubuntu-latest"
          "ubuntu-24.04-arm"
          "windows-latest"
          "macos-latest"
          "macos-13"
        }
      }
    }
    `runs-on` = "${{ matrix.os }}"
    `timeout-minutes` = 30
    steps {
      (commonSteps.jobs["checkoutStep"].steps[0]) {}
      (commonStepsRust.jobs["setupRustCacheStep"].steps[0]) {}
      (commonStepsRust.jobs["setupRustToolchainStep"].steps[0]) {
        with {
          ["toolchain"] = "stable"
          ["components"] = "clippy"
        }
      }
      new {
        name = "Run cargo clippy"
        run = "cargo clippy --workspace --all-targets --all-features --no-deps -- -D clippy::all" // temporarily removed -D clippy::cargo
        shell = "bash"
      }
    }
  }
  ["lockfile"] {
    name = "Cargo Lockfile"
    `runs-on` = "ubuntu-latest"
    `timeout-minutes` = 30
    steps {
      (commonSteps.jobs["checkoutStep"].steps[0]) {}
      (commonStepsRust.jobs["setupRustCacheStep"].steps[0]) {}
      (commonStepsRust.jobs["setupRustToolchainStep"].steps[0]) {
        with {
          ["toolchain"] = "stable"
        }
      }
      new {
        name = "Ensure Cargo.lock is up-to-date"
        run = "cargo update -p necronux --locked"
        shell = "bash"
      }
    }
  }
  ["check-version-bump"] {
    name = "Check Version Bump"
    `runs-on` = "ubuntu-latest"
    `timeout-minutes` = 30
    env {
      ["BASE_SHA"] = "${{ github.event.pull_request.base.sha }}"
      ["HEAD_SHA"] = "${{ github.event.pull_request.head.sha != '' && github.event.pull_request.head.sha || github.sha }}"
    }
    steps {
      (commonSteps.jobs["checkoutStep"].steps[0]) {
        with {
         ["fetch-depth"] = 0
        }
      }
      (commonStepsRust.jobs["setupRustCacheStep"].steps[0]) {}
      new {
        name = "Install cargo-semver-checks"
        uses = "taiki-e/install-action@cargo-semver-checks"
      }
      new {
        name = "Run cargo semver-checks"
        // Inputs:
        // BASE_SHA    The commit SHA of the branch where the PR wants to merge into.
        // HEAD_SHA    The commit SHA that triggered the workflow.
        // When `BASE_SHA` is missing, we assume it is from GitHub merge queue merge commit,
        // so hope `HEAD~` to find the previous commit on master branch.
        run = """
        set -euo pipefail
        base_sha=$(git rev-parse "${BASE_SHA:-HEAD~1}")
        head_sha=$(git rev-parse "${HEAD_SHA:-HEAD}")
        echo "Base revision is $base_sha"
        echo "Head revision is $head_sha"
        cargo semver-checks --baseline-rev "$base_sha" --workspace
        """
        shell = "bash"
      }
    }
  }
  ["msrv"] {
    name = "MSRV"
    `runs-on` = "ubuntu-latest"
    `timeout-minutes` = 30
    steps {
      (commonSteps.jobs["checkoutStep"].steps[0]) {}
      (commonStepsRust.jobs["setupRustCacheStep"].steps[0]) {}
      new {
        name = "Install cargo hack"
        uses = "taiki-e/install-action@cargo-hack"
      }
      new {
        name = "Run cargo hack check"
        run = "cargo hack check --all-targets --rust-version --locked"
        shell = "bash"
      }
    }
  }
}
