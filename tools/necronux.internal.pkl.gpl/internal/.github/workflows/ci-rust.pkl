@ModuleInfo { minPklVersion = "0.27.0" }

amends "../../../../commons/GitHubAction.pkl"

import "commons/commonJobs.pkl" as commonJobs
import "commons/commonSteps.pkl" as commonSteps
import "commons/commonStepsRust.pkl" as commonStepsRust

headercomment = """
# ==----------------------------------------------------------------== #
# SPDX-FileCopyrightText: © 2024-2025 Nayan Patil <nayantsg@proton.me>
#
# SPDX-License-Identifier: GPL-3.0-or-later
# ==----------------------------------------------------------------== #
"""

name = "CI-Rust"

on {
  pull_request {
    branches {
      "develop"
      "stable"
      "release"
      "hotfix"
    }
    paths {
      "*.rs"
      "**/*.rs"
      "src/**"
      "crates/**"
      "Cargo.toml"
      "Cargo.lock"
      "deny.toml"
    }
  }
  push {
    paths = (on.pull_request.paths) {}
  }
  workflow_dispatch {}
}

env {
  ["CARGO_INCREMENTAL"] = 0
  ["CARGO_NET_RETRY"] = 10
  ["CARGO_TERM_COLOR"] = "always"
  ["RUST_BACKTRACE"] = 1
  ["RUSTFLAGS"] = "-D warnings"
  ["RUSTUP_MAX_RETRIES"] = 10
  ["CARGO_HACK_DENY_WARNINGS"] = 1
}

concurrency {
  group = "${{ github.workflow }}-${{ github.event.pull_request.number || github.ref }}"
  `cancel-in-progress` = true
}

permissions {
  contents = "read"
}

jobs {
  ["conclusion-pr"] = (commonJobs.jobs["conclusion-pr"]) {
    needs = (jobs["conclusion-push"].needs) {
      [0] = "test-full"
    }
  }
  ["conclusion-push"] = (commonJobs.jobs["conclusion-push"]) {
    needs {
      "test-minimal"
      "check-version-bump"
      "clippy"
      "docs"
      "lockfile"
      "msrv"
      "rustfmt"
    }
  }

  ["rustfmt"] {
    name = "Rustfmt"
    `runs-on` = "ubuntu-latest"
    `timeout-minutes` = 30
    steps {
      (commonSteps.jobs["checkoutStep"].steps[0]) {}
      (commonStepsRust.jobs["setupRustToolchainStep"].steps[0]) {
        with {
          ["toolchain"] = "stable"
          ["components"] = "rustfmt"
        }
      }
      new {
        name = "Run cargo fmt"
        run = "cargo fmt --all --check"
        shell = "bash"
      }
    }
  }
  ["clippy"] {
    name = "Clippy"
    strategy {
      `fail-fast` = false
      matrix {
        ["os"] {
          "ubuntu-latest"
          "ubuntu-24.04-arm"
          "windows-latest"
          "macos-latest"
          "macos-13"
        }
      }
    }
    `runs-on` = "${{ matrix.os }}"
    `timeout-minutes` = 30
    steps {
      (commonSteps.jobs["checkoutStep"].steps[0]) {}
      (commonStepsRust.jobs["setupRustCacheStep"].steps[0]) {}
      (commonStepsRust.jobs["setupRustToolchainStep"].steps[0]) {
        with {
          ["toolchain"] = "stable"
          ["components"] = "clippy"
        }
      }
      new {
        name = "Run cargo clippy"
        run = "cargo clippy --workspace --all-targets --all-features --no-deps -- -D clippy::all" // temporarily removed -D clippy::cargo
        shell = "bash"
      }
    }
  }
  ["lockfile"] {
    name = "Cargo Lockfile"
    `runs-on` = "ubuntu-latest"
    `timeout-minutes` = 30
    steps {
      (commonSteps.jobs["checkoutStep"].steps[0]) {}
      (commonStepsRust.jobs["setupRustCacheStep"].steps[0]) {}
      (commonStepsRust.jobs["setupRustToolchainStep"].steps[0]) {
        with {
          ["toolchain"] = "stable"
        }
      }
      new {
        name = "Ensure Cargo.lock is up-to-date"
        run = "cargo update -p necronux --locked"
        shell = "bash"
      }
    }
  }
  ["check-version-bump"] {
    name = "Check Version Bump"
    `runs-on` = "ubuntu-latest"
    `timeout-minutes` = 30
    env {
      ["BASE_SHA"] = "${{ github.event.pull_request.base.sha }}"
      ["HEAD_SHA"] = "${{ github.event.pull_request.head.sha != '' && github.event.pull_request.head.sha || github.sha }}"
    }
    steps {
      (commonSteps.jobs["checkoutStep"].steps[0]) {
        with {
         ["fetch-depth"] = 0
        }
      }
      (commonStepsRust.jobs["setupRustCacheStep"].steps[0]) {}
      new {
        name = "Install cargo-semver-checks"
        uses = "taiki-e/install-action@cargo-semver-checks"
      }
      new {
        name = "Run cargo semver-checks"
        // Inputs:
        // BASE_SHA    The commit SHA of the branch where the PR wants to merge into.
        // HEAD_SHA    The commit SHA that triggered the workflow.
        // When `BASE_SHA` is missing, we assume it is from GitHub merge queue merge commit,
        // so hope `HEAD~` to find the previous commit on master branch.
        run = """
        set -euo pipefail
        base_sha=$(git rev-parse "${BASE_SHA:-HEAD~1}")
        head_sha=$(git rev-parse "${HEAD_SHA:-HEAD}")
        echo "Base revision is $base_sha"
        echo "Head revision is $head_sha"
        cargo semver-checks --baseline-rev "$base_sha" --workspace
        """
        shell = "bash"
      }
    }
  }
  ["test-minimal"] {
    name = "Minimal Tests (${{ matrix.name }})"
    `if` = "${{ github.event_name == 'push' && !cancelled() }}"
    strategy = (jobs["test-full"].strategy) {}
    `runs-on` = "${{ matrix.os }}"
    `timeout-minutes` = 30
    env = (jobs["test-full"].env) {}
    steps {
      (commonSteps.jobs["checkoutStep"].steps[0]) {}
      (commonStepsRust.jobs["setupRustCacheStep"].steps[0]) {}
      new {
        name = "Setup rustup stable"
        run = "rustup update --no-self-update stable"
        shell = "bash"
      }
      new {
        name = "Update rustup and set default version"
        run = "rustup update --no-self-update ${{ matrix.rust }} && rustup default ${{ matrix.rust }}"
        shell = "bash"
      }
      new {
        name = "Add rustup targets"
        run = "rustup target add ${{ matrix.other }}"
        shell = "bash"
      }
      new {
        name = "Configure extra test environment"
        `if`= "matrix.os == 'ubuntu-latest'"
        run = "echo CARGO_CONTAINER_TESTS=1 >> $GITHUB_ENV"
        shell = "bash"
      }
      // Tests
      new {
        name = "Run cargo test with default features in debug mode"
        run = "cargo test --lib --bins --workspace"
        shell = "bash"
      }
      new {
        name = "Run cargo test with all features in debug mode"
        run = "cargo test --lib --bins --workspace --all-features"
        shell = "bash"
      }
    }
  }
  ["test-full"] {
    name = "Full Tests (${{ matrix.name }})"
    `if` = "${{ github.event_name == 'pull_request' && !cancelled() }}"
    strategy {
      `fail-fast` = false
      matrix {
        ["include"] {
          new {
            name = "Linux x86_64 stable"
            os = "ubuntu-latest"
            rust = "stable"
            other = "i686-unknown-linux-gnu"
          }
          new {
            name = "Linux x86_64 beta"
            os = "ubuntu-latest"
            rust = "beta"
            other = "i686-unknown-linux-gnu"
          }
          new {
            name = "Linux x86_64 nightly"
            os = "ubuntu-latest"
            rust = "nightly"
            other = "i686-unknown-linux-gnu"
          }
          new {
            name = "Linux aarch64 stable"
            os = "ubuntu-24.04-arm"
            rust = "stable"
          }
          new {
            name = "Linux aarch64 nightly"
            os = "ubuntu-24.04-arm"
            rust = "nightly"
          }
          new {
            name = "Windows x86_64 MSVC stable"
            os = "windows-latest"
            rust = "stable-msvc"
            other = "i686-pc-windows-msvc"
          }
          new {
            name = "Windows x86_64 gnu nightly"
            os = "windows-latest"
            rust = "nightly-gnu"
            other = "i686-pc-windows-gnu"
          }
          new {
            name = "macOS aarch64 stable"
            os = "macos-latest"
            rust = "stable"
            other = "x86_64-apple-darwin"
          }
          new {
            name = "macOS aarch64 nightly"
            os = "macos-latest"
            rust = "nightly"
            other = "x86_64-apple-darwin"
          }
          new {
            name = "macOS x86_64 nightly"
            os = "macos-13"
            rust = "nightly"
          }
        }
      }
    }
    `runs-on` = "${{ matrix.os }}"
    `timeout-minutes` = 30
    env {
      ["CARGO_PROFILE_DEV_DEBUG"] = 1
      ["CARGO_PROFILE_TEST_DEBUG"] = 1
      // Workaround for https://github.com/rust-lang/rustup/issues/3036
      ["RUSTUP_WINDOWS_PATH_ADD_BIN"] = 0
    }
    steps {
      (commonSteps.jobs["checkoutStep"].steps[0]) {}
      (commonStepsRust.jobs["setupRustCacheStep"].steps[0]) {}
      new {
        name = "Setup rustup stable"
        run = "rustup update --no-self-update stable"
        shell = "bash"
      }
      new {
        name = "Update rustup and set default version"
        run = "rustup update --no-self-update ${{ matrix.rust }} && rustup default ${{ matrix.rust }}"
        shell = "bash"
      }
      new {
        name = "Add rustup targets"
        run = "rustup target add ${{ matrix.other }}"
        shell = "bash"
      }
      new {
        name = "Configure extra test environment"
        `if`= "matrix.os == 'ubuntu-latest'"
        run = "echo CARGO_CONTAINER_TESTS=1 >> $GITHUB_ENV"
        shell = "bash"
      }
      // Tests
      new {
        name = "Run cargo test with default features in debug mode"
        run = "cargo test --all-targets --workspace"
        shell = "bash"
      }
      new {
        name = "Run cargo test with all features in debug mode"
        run = "cargo test --all-targets --workspace --all-features"
        shell = "bash"
      }
      new {
        name = "Run cargo test with default features in release mode"
        run = "cargo test --all-targets --workspace --release"
        shell = "bash"
      }
      new {
        name = "Run cargo test with all features in release mode"
        run = "cargo test --all-targets --workspace --all-features --release"
        shell = "bash"
      }
    }
  }
 ["docs"] {
    name = "Docs"
    `runs-on` = "ubuntu-latest"
    `timeout-minutes` = 30
    env = (module.env) {
      ["RUSTFLAGS"] = "-C debuginfo=0 -D warnings"
    }
    steps {
      (commonSteps.jobs["checkoutStep"].steps[0]) {}
      (commonStepsRust.jobs["setupRustCacheStep"].steps[0]) {}
      (commonStepsRust.jobs["setupRustToolchainStep"].steps[0]) {
        with {
          ["toolchain"] = "stable"
        }
      }
      new {
        name = "Run cargo doc"
        run = "cargo doc --workspace --all-features --no-deps --document-private-items --keep-going"
        shell = "bash"
        env {
          ["RUSTDOCFLAGS"] = "-D warnings"
        }
      }
      new {
        name = "Run cargo test with all features in debug mode"
        run = "cargo test --doc --workspace --all-features"
        shell = "bash"
      }
    }
  }
  ["msrv"] {
    name = "MSRV"
    `runs-on` = "ubuntu-latest"
    `timeout-minutes` = 30
    steps {
      (commonSteps.jobs["checkoutStep"].steps[0]) {}
      (commonStepsRust.jobs["setupRustCacheStep"].steps[0]) {}
      new {
        name = "Install cargo hack"
        uses = "taiki-e/install-action@cargo-hack"
      }
      new {
        name = "Run cargo hack check"
        run = "cargo hack check --all-targets --rust-version --locked"
        shell = "bash"
      }
    }
  }
}
