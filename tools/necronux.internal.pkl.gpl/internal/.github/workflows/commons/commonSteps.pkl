@ModuleInfo { minPklVersion = "0.27.0" }

amends "../../../../../commons/GitHubAction.pkl"

// Placeholder name to satisfy type-checking
name = "Common Steps"

// Placeholder trigger to satisfy type-checking
on {
  workflow_dispatch {}
}

jobs {
  // Placeholder job to satisfy type-checking
  ["checkoutStep"] {
    `runs-on` = "ubuntu-latest"
    steps {
      new {
        name = "Checkout code"
        uses = "actions/checkout@v4"
      }
    }
  }
  // Placeholder job to satisfy type-checking
  ["installJustStep"] {
    `runs-on` = "ubuntu-latest"
    steps {
      new {
        name = "Install just"
        uses = "taiki-e/install-action@just"
      }
    }
  }
}
