@ModuleInfo { minPklVersion = "0.27.0" }
module WorkflowSelfApprove

amends "../../../../commons/GitHubAction.pkl"

import "helpers/Common.pkl"

import "modules/workflow-self-approve-jobs.pkl" as WorkflowSelfApproveJobs

headercomment = Common.headerComment("2024-2025", "Nayan Patil <nayantsg@proton.me>", "GPL-3.0-or-later")
name = "Workflow-LGTM-Self-Approve"
permissions = (Common.contentPermissions("read")) {}

on {
  issue_comment {
    types {
      "created"
    }
  }
  pull_request_review {
    types {
      "edited"
    }
  }
  pull_request_review_comment {
    types {
      "created"
    }
  }
}
jobs {
  ["auto-approve"] = (WorkflowSelfApproveJobs.approvePRReview()) {}
}
