@ModuleInfo { minPklVersion = "0.27.0" }
module necronux.internal.ci.workflowSelfApprove

amends "../../../../commons/GitHubAction.pkl"

import "helpers/Actions.pkl"
import "helpers/Common.pkl"

headercomment = """
# ==----------------------------------------------------------------== #
# SPDX-FileCopyrightText: © 2024-2025 Nayan Patil <nayantsg@proton.me>
#
# SPDX-License-Identifier: GPL-3.0-or-later
# ==----------------------------------------------------------------== #
"""

name = "LGTM Self Approve"

on {
  issue_comment {
    types {
      "created"
    }
  }
  pull_request_review {
    types {
      "edited"
    }
  }
  pull_request_review_comment {
    types {
      "created"
    }
  }
}

permissions {
  contents = "read"
}

jobs {
  ["auto-approve"] {
    ...Common.standardJobConfig(null, null)
    name = "Approve PR Review"
    permissions {
      `pull-requests` = "write"
    }
    steps {
      new {
        name = "Approve Review by NayanTheSpaceGuy"
        uses = Actions.githubScript
        `if` = "github.actor == 'NayanTheSpaceGuy' && contains(github.event.comment.body, 'LGTM')"
        with {
          ["script"] = """
          github.rest.pulls.createReview({
            owner: context.repo.owner,
            repo: context.repo.repo,
            pull_number: context.issue.number,
            review_id: 1,
            event: 'APPROVE',
            body: 'Let`s get this merged then.'
          })
          """
        }
      }
    }
  }
}
