@ModuleInfo { minPklVersion = "0.27.0" }
module necronux.internal.ci.matrices

import "../../../../../commons/GitHubAction.pkl" as gha

// Runners
const linuxRunner64 = "ubuntu-24.04"
const linuxRunner64Arm = "ubuntu-24.04-arm"
const macOSRunner64 = "macos-13"
const macOSRunner64Arm = "macos-15"
const windowsRunner64 = "windows-2025"

// Toolchains
const rustStableLinux64 = "stable-x86_64-unknown-linux-gnu"
const rustBetaLinux64 = "beta-x86_64-unknown-linux-gnu"
const rustNightlyLinux64 = "nightly-x86_64-unknown-linux-gnu"
const rustStableLinux64Arm = "stable-aarch64-unknown-linux-gnu"
const rustStableMacOS64 = "stable-x86_64-apple-darwin"
const rustStableMacOS64Arm = "stable-aarch64-apple-darwin"
const rustStableWindowsMSVC64 = "stable-x86_64-pc-windows-msvc"
const rustStableWindowsGNU64 = "stable-x86_64-pc-windows-gnu"

const function rustMatrixTestFull() = new Listing {
  ...linuxx8664BetaAndNightly()
  ...rustMatrixBuild()
}

const function rustMatrixBuild() = new Listing {
  ...rustMatrixBase(true)
  new {
    name = "[freeBSD & netBSD] x86_64 Stable"
    os = linuxRunner64
    toolchain = rustStableLinux64
    target = "x86_64-unknown-freebsd"
    other = "x86_64-unknown-netbsd"
  }
  new {
    name = "Linux-GNU [i686 & PowerPC] Stable"
    os = linuxRunner64
    toolchain = rustStableLinux64
    target = "i686-unknown-linux-gnu"
    other = "powerpc-unknown-linux-gnu"
  }
  new {
    name = "Linux-GNU [PPC64 & PPC64LE] Stable"
    os = linuxRunner64
    toolchain = rustStableLinux64
    target = "powerpc64-unknown-linux-gnu"
    other = "powerpc64le-unknown-linux-gnu"
  }
  new {
    name = "[Linux-GNU & Linux-MUSL] armv7 Stable"
    os = linuxRunner64Arm
    toolchain = rustStableLinux64Arm
    target = "armv7-unknown-linux-gnueabi"
    other = "armv7-unknown-linux-musleabi"
  }
  new {
    name = "[Linux-GNUhf & Linux-MUSLhf] armv7 Stable"
    os = linuxRunner64Arm
    toolchain = rustStableLinux64Arm
    target = "armv7-unknown-linux-gnueabihf"
    other = "armv7-unknown-linux-musleabihf"
  }
  new {
    name = "Windows-MSVC aarch64 Stable"
    os = windowsRunner64
    toolchain = rustStableWindowsMSVC64
    target = "aarch64-pc-windows-msvc"
  }
}

const function rustMatrixTestMinimal() = new Listing {
  ...linuxx8664BetaAndNightly()
  ...rustMatrixBase(false)
}

const function rustMatrixBase(other: Boolean?) = new Listing {
  linuxx8664Stable(other ?? false)
  new {
    name = "macOS x86_64 Stable"
    os = macOSRunner64
    toolchain = rustStableMacOS64
    target = "x86_64-apple-darwin"
  }
  new {
    name = "macOS aarch64 Stable"
    os = macOSRunner64Arm
    toolchain = rustStableMacOS64Arm
    target = "aarch64-apple-darwin"
  }
  windowsMSVCStable(other ?? false)
  windowsGNUStable(other ?? false)
}

const function linuxx8664BetaAndNightly() = new {
  new {
    name = "Linux-GNU x86_64 Nightly"
    os = linuxRunner64
    toolchain = rustNightlyLinux64
    target = "x86_64-unknown-linux-gnu"
  }
  new {
    name = "Linux-GNU x86_64 Beta"
    os = linuxRunner64
    toolchain = rustBetaLinux64
    target = "x86_64-unknown-linux-gnu"
  }
}

const function linuxx8664Stable(other: Boolean) = if (other) new {
  name = "[Linux-GNU & Linux-MUSL] x86_64 Stable"
  os = linuxRunner64
  toolchain = rustStableLinux64
  target = "x86_64-unknown-linux-gnu"
  other = "x86_64-unknown-linux-musl"
} else new {
  name = "Linux-GNU x86_64 Stable"
  os = linuxRunner64
  toolchain = rustStableLinux64
  target = "x86_64-unknown-linux-gnu"
}
const function windowsMSVCStable(other: Boolean) = if (other) new {
  name = "Windows-MSVC [x86_64 & i686] Stable"
  os = windowsRunner64
  toolchain = rustStableWindowsMSVC64
  target = "x86_64-pc-windows-msvc"
  other = "i686-pc-windows-msvc"
} else new {
  name = "Windows-MSVC x86_64 Stable"
  os = windowsRunner64
  toolchain = rustStableWindowsMSVC64
  target = "x86_64-pc-windows-msvc"
}
const function windowsGNUStable(other: Boolean) = if (other) new {
  name = "Windows-GNU [x86_64 & i686] Stable"
  os = windowsRunner64
  toolchain = rustStableWindowsGNU64
  target = "x86_64-pc-windows-gnu"
  other = "i686-pc-windows-gnu"
} else new {
  name = "Windows-GNU x86_64 Stable"
  os = windowsRunner64
  toolchain = rustStableWindowsGNU64
  target = "x86_64-pc-windows-gnu"
}
