@ModuleInfo { minPklVersion = "0.27.0" }
module necronux.internal.ci.steps

import "../../../../../commons/GitHubAction.pkl" as gha

import "Actions.pkl"

const function checkout(depth: Int?) = new gha.Step {
  name = "Checkout code"
  uses = Actions.checkout
  with {
    ["fetch-depth"] = depth ?? 1
  }
}

const function checkoutWithRef(depth: Int?, ref: String) = new gha.Step {
  name = "Checkout code"
  uses = Actions.checkout
  with {
    ["fetch-depth"] = depth ?? 1
    ["ref"] = ref
  }
}

const function installAction(tool: String) = new gha.Step {
  name = "Install \(tool)"
  uses = Actions.installAction
  with {
    ["tool"] = tool
  }
}

const function conclusionJQ() = new gha.Step {
  name = "Conclusion"
  run = """
  jq -C <<< '${{ toJson(needs) }}'
  jq --exit-status 'all(.result == "success")' <<< '${{ toJson(needs) }}'
  """
  shell = "bash"
}

// ================ //
// --- Rustup
// =============== //

const function setupRustToolchain(toolchain: String) = new gha.Step {
  name = "Setup rust toolchain"
  uses = Actions.rustToolchain
  with {
    ["toolchain"] = toolchain
  }
}

const function setupRustToolchainWithComponent(toolchain: String, component: String) = new gha.Step {
  name = "Setup rust toolchain"
  uses = Actions.rustToolchain
  with {
    ["toolchain"] = toolchain
    ["components"] = component
  }
}

const function setupRustCache() = new gha.Step {
  name = "Setup rust cache"
  uses = Actions.rustCache
  with {
    ["save-if"] = "${{ github.ref == 'refs/heads/develop' || startsWith(github.ref, 'refs/heads/release/v') }}"
  }
}

const function setupRustCacheWithMatrixKey() = new gha.Step {
  name = "Setup rust cache"
  uses = Actions.rustCache
  with {
    ["save-if"] = "${{ github.ref == 'refs/heads/develop' || startsWith(github.ref, 'refs/heads/release/v') }}"
    ["key"] = "${{ github.job }}-${{ matrix.os }}-${{ matrix.rust }}-${{ matrix.name }}"
  }
}

const function rustupAndConfigExtra() = new {
  ...rustup()
  configExtra()
}
const function rustup() = new {
  setupRustupStable()
  updateRustup()
  rustupTargetAdd()
}
const function setupRustupStable() = new gha.Step {
  name = "Setup rustup stable"
  run = "rustup update --no-self-update stable"
  shell = "bash"
}
const function updateRustup() = new gha.Step {
  name = "Update rustup and set default version"
  run = "rustup update --no-self-update ${{ matrix.rust }} && rustup default ${{ matrix.rust }}"
  shell = "bash"
}
const function rustupTargetAdd() = new gha.Step {
  `if` = "${{ matrix.other != null }}"
  name = "Add rustup targets"
  run = "rustup target add ${{ matrix.other }}"
  shell = "bash"
}
const function configExtra() = new gha.Step {
  name = "Configure extra test environment"
  `if`= "matrix.os == 'ubuntu-latest'"
  run = "echo CARGO_CONTAINER_TESTS=1 >> $GITHUB_ENV"
  shell = "bash"
}
