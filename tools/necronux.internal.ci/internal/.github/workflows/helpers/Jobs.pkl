@ModuleInfo { minPklVersion = "0.27.0" }
module jobs

import "../../../../../commons/GitHubAction.pkl" as gha

import "Common.pkl"

// Conclusion Jobs:
// To prevent this job from being skipped if its dependencies fail,
// we need to override the if: condition. A skipped job is treated as a success by GitHub,
// which we want to avoid. By using !cancelled(), we ensure the job won't run
// if the workflow is manually canceled.

const function conclusionPR(): gha.Job = new {
  ...Common.standardJobConfig()
  name = "Conclusion PR"
  `if` = "${{ (github.event_name == 'pull_request' || (github.event_name == 'workflow_dispatch' && github.event.inputs.trigger_event == 'pull_request')) && !cancelled() }}"
  permissions {
    contents = conclusionJobPermissions
  }
  steps {
    conclusionJQ()
  }
}

const function conclusionPush(): gha.Job = new {
  ...Common.standardJobConfig()
  name = "Conclusion Push"
  `if` = "${{ (github.event_name == 'push' || (github.event_name == 'workflow_dispatch' && github.event.inputs.trigger_event == 'push')) && !cancelled() }}"
  permissions {
    contents = conclusionJobPermissions
  }
  steps {
    conclusionJQ()
  }
}

const function conclusionAll(): gha.Job = new {
  ...Common.standardJobConfig()
  name = "Conclusion"
  `if` = "${{ !cancelled() }}"
  permissions {
    contents = conclusionJobPermissions
  }
  steps {
    conclusionJQ()
  }
}

const conclusionJobPermissions = "none"

const function conclusionJQ(): gha.Step = new {
  // Manually check the status of all dependencies. `if: failure()` does not work.
  name = "Conclusion"
  run = """
  jq -C <<< '${{ toJson(needs) }}'
  jq --exit-status 'all(.result == "success")' <<< '${{ toJson(needs) }}'
  """
  shell = "bash"
}
