@ModuleInfo { minPklVersion = "0.27.0" }
module necronux.internal.ci.common

const function standardJobConfig(machine: String?, timeout: Int?) = new {
  `runs-on` = machine ?? "ubuntu-latest"
  `timeout-minutes` = timeout ?? 30
}
