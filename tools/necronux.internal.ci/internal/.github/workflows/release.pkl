@ModuleInfo { minPklVersion = "0.27.0" }
module release

amends "../../../../commons/GitHubAction.pkl"

import "helpers/Triggers.pkl"

import "modules/release-necronux-cli.pkl" as Cli
import "modules/release-necronux-stdschema.pkl" as Stdschema
import "modules/release-validate-and-publish.pkl" as ValPub

headercomment = """
# ==---------------------------------------------------------------== #
# SPDX-FileCopyrightText: © 2024-2025 Nayan Patil <nayantsg@proton.me>
#
# SPDX-License-Identifier: GPL-3.0-or-later
# ==---------------------------------------------------------------== #
"""

name = "Necronux Release"

on {
  workflow_dispatch {
    inputs {
      ["release_type"] = (Triggers.wDispatchReleaseType()) {}
      ["release_tag"] = (Triggers.wDispatchReleaseTag()) {}
    }
  }
}

permissions {
  contents = "write"
}

jobs {
  ["validate-release"] = (ValPub.validate()) {}
  ["build-necronux-cli"] = (Cli.build()) {}
  ["stable-release"] = (Cli.stableRelease()) {}
  ["pre-release"] = (Cli.preRelease()) {}
  ["pklstable-release"] = (Stdschema.stableRelease()) {}
  ["pklpre-release"] = (Stdschema.preRelease()) {}
}
