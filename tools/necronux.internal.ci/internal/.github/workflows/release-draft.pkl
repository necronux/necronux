@ModuleInfo { minPklVersion = "0.27.0" }
module ReleaseDraft

amends "../../../../commons/GitHubAction.pkl"

import "helpers/Common.pkl"
import "helpers/Triggers.pkl"

import "modules/release-draft-validate.pkl" as Validate
import "modules/release-draft-build.pkl" as Build
import "modules/release-necronux-stdschema.pkl" as Stdschema

headercomment = Common.headerComment("2024-2025", "Nayan Patil <nayantsg@proton.me>", "GPL-3.0-or-later")
name = "Release-Draft"
permissions = (Common.contentPermissions("read")) {}

on {
  workflow_dispatch {
    inputs {
      ["release_type"] = (Triggers.wDispatchReleaseType()) {}
      ["release_tag"] = (Triggers.wDispatchReleaseTag()) {}
    }
  }
}
jobs {
  ["validate-release-tag"] = (Validate.releaseTag()) {}
  ["validate-release-type"] = (Validate.releaseType()) {}
  ["build-necronux-cli"] = (Build.necronux_cli()) {}
  // ["build-necronux-stdschema"] = (Build.necronux_stdschema()) {}
  // ["dryrun-necronux-cli-cargo"] = (DryRun.necronux_stdschema()) {}
  // ["create-release-draft"] = (PublishDraft.necronux()) {}
}
