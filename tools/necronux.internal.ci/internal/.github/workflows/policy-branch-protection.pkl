@ModuleInfo { minPklVersion = "0.27.0" }
module necronux.internal.ci.policyBranchProtection

amends "../../../../commons/GitHubAction.pkl"

import "helpers/Common.pkl"

import "modules/policy-branch-protection-jobs.pkl" as PolicyBranchProtJobs

headercomment = Common.headerComment("2024-2025", "Nayan Patil <nayantsg@proton.me>", "GPL-3.0-or-later")
name = "Policy-Branch-Protection"
permissions = (Common.contentPermissions("read")) {}

on {
  pull_request {}
}
jobs {
  ["protect-develop-branch"] = (PolicyBranchProtJobs.protectDevelopBranch()) {}
  ["protect-release-branches"] = (PolicyBranchProtJobs.protectReleaseBranches()) {}
}
