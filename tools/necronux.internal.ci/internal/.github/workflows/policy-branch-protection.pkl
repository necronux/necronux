@ModuleInfo { minPklVersion = "0.27.0" }
module policyBranchProtection

amends "../../../../commons/GitHubAction.pkl"

import "helpers/Common.pkl"
import "helpers/Steps.pkl"

headercomment = """
# ==----------------------------------------------------------------== #
# SPDX-FileCopyrightText: © 2024-2025 Nayan Patil <nayantsg@proton.me>
#
# SPDX-License-Identifier: GPL-3.0-or-later
# ==----------------------------------------------------------------== #
"""

name = "Branch Protection"

on {
  pull_request {}
}

permissions {
  contents = "read"
}

jobs {
  ["protect-develop-branch"] {
    ...Common.standardJobConfig()
    name = "Protect Develop Branch"
    steps {
      Steps.checkout(null)
      new {
        name = "Ensure PRs to develop branch are only from allowed branches"
        run = "tools/scripts/ci/protect-develop-branch.sh"
        shell = "bash"
      }
    }
  }
  ["protect-release-branches"] {
    ...Common.standardJobConfig()
    name = "Protect Release Branches"
    steps {
      Steps.checkout(null)
      new {
        name = "Ensure PRs to release branches are only from allowed branches"
        run = "tools/scripts/ci/protect-release-branches.sh"
        shell = "bash"
      }
    }
  }
}
