@ModuleInfo { minPklVersion = "0.27.0" }
module necronux.internal.ci.policyReuseLint

amends "../../../../commons/GitHubAction.pkl"

import "helpers/Actions.pkl"
import "helpers/Common.pkl"
import "helpers/Steps.pkl"

headercomment = """
# ==-----------------------------------------------------------== //
# SPDX-FileCopyrightText: © 2025 Nayan Patil <nayantsg@proton.me>
#
# SPDX-License-Identifier: GPL-3.0-or-later
# ==-----------------------------------------------------------== //
"""

name = "REUSE Compliance Check"

on {
  push {}
  pull_request {}
  workflow_dispatch {}
}

permissions {
  contents = "read"
}

jobs {
  ["reuse-compliance-check"] {
    ...Common.standardJobConfig(null, null)
    name = "REUSE Compliance Check"
    steps {
      Steps.checkout(null)
      new {
        name = "REUSE Compliance Check"
        uses = Actions.reuseAction
      }
    }
  }
}
