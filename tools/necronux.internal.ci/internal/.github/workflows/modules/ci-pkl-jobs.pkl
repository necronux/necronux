@ModuleInfo { minPklVersion = "0.27.0" }
module necronux.internal.ci.ciPkl.jobs

import "../../../../../commons/GitHubAction.pkl" as gha

import "../helpers/Common.pkl"
import "../helpers/Steps.pkl"

const function resolveCheck() = new gha.Job {
  name = "Resolve Check"
  steps {
    Steps.checkout(null)
    Steps.installAction("just")
    new {
      name = "Check if necronux.std.schema pkl project can be resolved"
      run = "just resolve-stdschemapkl"
      shell = "bash"
    }
    new {
      name = "Check if necronux internal pkl projects can be resolved"
      run = "just resolve-internalpkl"
      shell = "bash"
    }
  }
} |> Common.standardJobConfig(null, null)

const function evalCheck() = new gha.Job {
  name = "Eval Check"
  steps {
    Steps.checkout(null)
    Steps.installAction("just")
    new {
      name = "Check if necronux.std.schema pkl modules can be evaluated"
      run = "just eval-stdschemapkl"
      shell = "bash"
    }
    new {
      name = "Check if necronux internal pkl modules can be evaluated"
      run = "just eval-internalpkl"
      shell = "bash"
    }
    new {
      name = "Verify necronux internal pkl modules evaluation reflects the latest changes"
      run = "git diff --exit-code"
      shell = "bash"
    }
  }
} |> Common.standardJobConfig(null, null)

const function tests() = new gha.Job {
  name = "Tests"
  steps {
    Steps.checkout(null)
    Steps.installAction("just")
    new {
      name = "Test necronux.std.schema pkl modules"
      run = "just test-stdschemapkl"
      shell = "bash"
    }
  }
} |> Common.standardJobConfig(null, null)
