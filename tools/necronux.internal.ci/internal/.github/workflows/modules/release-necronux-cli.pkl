@ModuleInfo { minPklVersion = "0.27.0" }
module necronux.internal.ci.release.necronuxCli

import "../../../../../commons/GitHubAction.pkl" as gha

import "../helpers/Common.pkl"
import "../helpers/EnvVars.pkl"
import "../helpers/Matrices.pkl"
import "../helpers/Steps.pkl"

const function build() = new gha.Job {
  name = "Build Necronux CLI App"
  needs {
    "validate-release"
  }
  strategy {
    `fail-fast` = false
    matrix {
      ["include"] = (Matrices.rustMatrixBuild()) {}
    }
  }
  env = (EnvVars.rustEnvFull) {}
  steps {
    Steps.checkout(null)
    Steps.setupRustup("${{ matrix.toolchain }}")
    Steps.addTargetRustup("${{ matrix.target }}")
    Steps.addMatrixOtherTargetRustup("${{ matrix.other }}")
    new {
      name = "Build release binary"
      run = "cargo build --release --locked --workspace"
      shell = "bash"
    }
    new {
      name = "Rename necronux binary"
      shell = "bash"
      run = """
        binary_name="necronux"

        extension=""
        # windows binaries have ".exe" extension
        if [[ "${{ matrix.os }}" == "windows-latest" ]]; then
        extension=".exe"
        fi

        mkdir bin
        cp "target/${{ matrix.build.name }}/release/${binary_name}" "bin/${binary_name}-${{ matrix.build.name }}${extension}"
        """
    }
    new {
      name = "Make binaries executable (Non-Windows)"
      `if` = "! contains(matrix.build.os, 'windows-latest')"
      run = "chmod +x bin/*"
    }
    new {
      name = "Tar the binaries"
      shell = "bash"
      run = "tar -czvf built-binaries-${{ github.run_id }}-${{ matrix.build.NAME }}.tar.gz -C bin ."
    }
    new {
      name = "Upload binary tar"
      uses = "actions/upload-artifact@v4"
      with {
        ["name"] = "built-binaries-${{ github.run_id }}-${{ matrix.build.NAME }}"
        ["path"] = "built-binaries-${{ github.run_id }}-${{ matrix.build.NAME }}.tar.gz"
      }
    }
  }
} |> Common.standardJobConfig("${{ matrix.os }}", null)

const function stableRelease() = new gha.Job {
  name = "Release"
  needs = "build"
  `if` = "startsWith(github.ref_name, 'v') && !contains(github.ref_name, '-')"
  steps {
    Steps.checkout(null)
    new {
      name = "Download binaries"
      uses = "actions/download-artifact@v4"
      with {
        ["path"] = "."
        ["merge-multiple"] = true
      }
    }
    new {
      name = "Extract binaries"
      shell = "bash"
      run = """
        mkdir -p bin
        for tar_file in built-binaries-*.tar.gz; do
        echo "Extracting $tar_file"
        tar -xzvf $tar_file -C bin
        done
        """
    }
    new {
      name = "Publish release"
      uses = "softprops/action-gh-release@v2"
      with {
        ["files"] = "bin/*"
        ["tag_name"] = "${{ env.RELEASE_VERSION }}"
        ["fail_on_unmatched_files"] = true
        ["generate_release_notes"] = true
      }
      env {
        ["GITHUB_TOKEN"] = "${{ secrets.GITHUB_TOKEN }}"
      }
    }
  }
} |> Common.standardJobConfig("ubuntu-24.04", null)

const function preRelease() = new gha.Job {
  name = "Pre-Release"
  needs = "build"
  `if` = "startsWith(github.ref_name, 'v') && contains(github.ref_name, '-')"
  steps {
    Steps.checkout(null)
    new {
      name = "Download binaries"
      uses = "actions/download-artifact@v4"
      with {
        ["path"] = "."
        ["merge-multiple"] = true
      }
    }
    new {
      name = "Extract binaries"
      shell = "bash"
      run = """
        mkdir -p bin
        for tar_file in built-binaries-*.tar.gz; do
        echo "Extracting $tar_file"
        tar -xzvf $tar_file -C bin
        done
        """
    }
    new {
      name = "Publish release"
      uses = "softprops/action-gh-release@v2"
      with {
        ["files"] = "bin/*"
        ["tag_name"] = "${{ env.PRE_RELEASE_VERSION }}"
        ["fail_on_unmatched_files"] = true
        ["generate_release_notes"] = true
        ["prerelease"] = true
      }
      env {
        ["GITHUB_TOKEN"] = "${{ secrets.GITHUB_TOKEN }}"
      }
    }
  }
} |> Common.standardJobConfig("ubuntu-24.04", null)
