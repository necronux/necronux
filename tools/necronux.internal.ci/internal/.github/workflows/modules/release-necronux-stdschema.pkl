@ModuleInfo { minPklVersion = "0.27.0" }
module release.necronux.stdschema

import "../../../../../commons/GitHubAction.pkl" as gha

import "../helpers/Common.pkl"
import "../helpers/Steps.pkl"

const function stableRelease(): gha.Job = new {
  name = "Release Necronux Standard Schema"
  `runs-on` = "ubuntu-24.04"
  `if` = "startsWith(github.ref_name, 'necronux.std.schema') && !contains(github.ref_name, '-')"
  `timeout-minutes` = 30
  steps {
    Steps.checkout(0)
    Steps.installAction("just")
    new {
      name = ""
      run = "just make-stdschemapklpkg"
      shell = "bash"
      env {
        ["VERSION"] = "${{ github.ref_name }}"
      }
    }
    new {
      name = "Extract version number from tag"
      run = """
        VERSION_NUMBER=${{ github.ref_name }}
        VERSION_NUMBER=${VERSION_NUMBER#*@}
        echo "VERSION_NUMBER=$VERSION_NUMBER" >> $GITHUB_ENV
        """
      shell = "bash"
    }
    new {
      name = "Publish release"
      uses = "softprops/action-gh-release@v2"
      with {
        ["files"] = ".out/necronux.stdschema${{ env.VERSION_NUMBER }}/*"
        ["tag_name"] = "${{ env.RELEASE_VERSION }}"
        ["fail_on_unmatched_files"] = true
        ["generate_release_notes"] = true
      }
      env {
        ["GITHUB_TOKEN"] = "${{ secrets.GITHUB_TOKEN }}"
      }
    }
  }
}

const function preRelease(): gha.Job = new {
  name = "Pre-Release"
  `runs-on` = "ubuntu-24.04"
  `if` = "startsWith(github.ref_name, 'necronux.std.schema') && contains(github.ref_name, '-')"
  `timeout-minutes` = 30
  steps {
    Steps.checkout(0)
    Steps.installAction("just")
    new {
      name = ""
      run = "just make-stdschemapklpkg"
      shell = "bash"
      env {
        ["VERSION"] = "${{ github.ref_name }}"
      }
    }
    new {
      name = "Extract version number from tag"
      run = """
        VERSION_NUMBER=${{ github.ref_name }}
        VERSION_NUMBER=${VERSION_NUMBER#*@}
        echo "VERSION_NUMBER=$VERSION_NUMBER" >> $GITHUB_ENV
        """
      shell = "bash"
    }
    new {
      uses = "softprops/action-gh-release@v2"
      with {
        ["files"] = ".out/necronux.stdlib${{ env.VERSION_NUMBER }}/*"
        ["tag_name"] = "${{ env.PRE_RELEASE_VERSION }}"
        ["fail_on_unmatched_files"] = true
        ["generate_release_notes"] = true
        ["prerelease"] = true
      }
      env {
        ["GITHUB_TOKEN"] = "${{ secrets.GITHUB_TOKEN }}"
      }
    }
  }
}
