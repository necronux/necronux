@ModuleInfo { minPklVersion = "0.27.0" }
module ReleaseDraftDryrun

import "../../../../../commons/GitHubAction.pkl" as gha

import "../helpers/Actions.pkl"
import "../helpers/Common.pkl"
import "../helpers/Steps.pkl"

const function cratesioNecronux() = new gha.Job {
  name = "Dry Run: Publish Necronux Crates On Crates.io"
  needs {
    "build-necronux-cli"
    "build-necronux-stdschema"
    "generate-sbom"
  }
  steps {
    Steps.checkout(null)
    new {
      name = "REUSE SPDX SBOM"
      uses = Actions.reuseAction
      with {
        ["args"] = "spdx -o reuse.spdx"
      }
    }
    new {
      name = "Run publish crates.io script with --dry-run"
      run = "tools/scripts/ci/publish-crates-io.sh --dry-run"
      shell = "bash"
    }
  }
} |> Common.standardJobConfig(null, null)
