@ModuleInfo { minPklVersion = "0.27.0" }
module WorkflowSelfApproveJobs

import "../../../../../commons/GitHubAction.pkl" as gha

import "../helpers/Actions.pkl"
import "../helpers/Common.pkl"

const function approvePRReview() = new gha.Job {
  name = "Approve PR Review"
  permissions {
    `pull-requests` = "write"
  }
  steps {
    new {
      name = "Approve Review by NayanTheSpaceGuy"
      uses = Actions.githubScript
      `if` = "github.actor == 'NayanTheSpaceGuy' && contains(github.event.comment.body, 'LGTM')"
      with {
        ["script"] = """
        github.rest.pulls.createReview({
          owner: context.repo.owner,
          repo: context.repo.repo,
          pull_number: context.issue.number,
          review_id: 1,
          event: 'APPROVE',
          body: 'Let`s get this merged then.'
        })
        """
      }
    }
  }
} |> Common.standardJobConfig(null, null)
