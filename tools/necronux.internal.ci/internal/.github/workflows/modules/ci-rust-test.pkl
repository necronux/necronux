@ModuleInfo { minPklVersion = "0.27.0" }
module necronux.internal.ci.ciRust.test

import "../../../../../commons/GitHubAction.pkl" as gha

import "../helpers/Common.pkl"
import "../helpers/EnvVars.pkl"
import "../helpers/Matrices.pkl"
import "../helpers/Steps.pkl"

const function testMinimal() = new gha.Job {
  name = "Minimal Tests (${{ matrix.name }})"
  `if` = "${{ (github.event_name == 'push' || (github.event_name == 'workflow_dispatch' && github.event.inputs.trigger_event == 'push')) && !cancelled() }}"
  strategy {
  `fail-fast` = false
    matrix {
      ["include"] = (Matrices.rustMatrixTestMinimal()) {}
    }
  }
  env = (EnvVars.rustEnvTest) {}
  steps {
    Steps.checkout(null)
    Steps.setupRustCacheWithMatrixKey()
    Steps.installPodmanAptIf("${{ matrix.buildtool == 'cross' }}")
    new {
      `if` = "${{ matrix.buildtool != 'cross' }}"
      ...Common.setupRustToolchainCommon()
      with {
        ["toolchain"] = "${{ matrix.toolchain }}"
        ["targets"] = "${{ matrix.target }}"
      }
    }
    new {
      `if` = "${{ matrix.buildtool == 'cross' }}"
      ...Common.setupRustToolchainCommon()
      with {
        ["toolchain"] = "${{ matrix.toolchain }}"
      }
    }
    Steps.installActionIf("cross", "${{ matrix.buildtool == 'cross' }}")
    new {
      name = "Run cargo test with default features in debug mode"
      run = "${{ matrix.buildtool }} test --lib --bins --workspace --target ${{ matrix.target }}"
      shell = "bash"
    }
    new {
      name = "Run cargo test with all features in debug mode"
      run = "${{ matrix.buildtool }} test --lib --bins --workspace --all-features --target ${{ matrix.target }}"
      shell = "bash"
    }
  }
} |> Common.standardJobConfig("${{ matrix.os }}", null)

const function testFull() = new gha.Job {
  name = "Full Tests (${{ matrix.name }})"
  `if` = "${{ (github.event_name == 'pull_request' || (github.event_name == 'workflow_dispatch' && github.event.inputs.trigger_event == 'pull_request')) && !cancelled() }}"
  strategy {
  `fail-fast` = false
    matrix {
      ["include"] = (Matrices.rustMatrixTestFull()) {}
    }
  }
  env = (EnvVars.rustEnvTest) {}
  steps {
    Steps.checkout(null)
    Steps.setupRustCacheWithMatrixKey()
    Steps.installPodmanAptIf("${{ matrix.buildtool == 'cross' }}")
    new {
      `if` = "${{ matrix.buildtool != 'cross' }}"
      ...Common.setupRustToolchainCommon()
      with {
        ["toolchain"] = "${{ matrix.toolchain }}"
        ["targets"] = "${{ matrix.target }}"
      }
    }
    new {
      `if` = "${{ matrix.buildtool == 'cross' }}"
      ...Common.setupRustToolchainCommon()
      with {
        ["toolchain"] = "${{ matrix.toolchain }}"
      }
    }
    Steps.installActionIf("cross", "${{ matrix.buildtool == 'cross' }}")
    new {
      name = "Run cargo test with default features in debug mode"
      run = "${{ matrix.buildtool }} test --all-targets --workspace --target ${{ matrix.target }}"
      shell = "bash"
    }
    new {
      name = "Run cargo test with all features in debug mode"
      run = "${{ matrix.buildtool }} test --all-targets --workspace --all-features --target ${{ matrix.target }}"
      shell = "bash"
    }
    new {
      name = "Run cargo test with default features in release mode"
      run = "${{ matrix.buildtool }} test --all-targets --workspace --release --target ${{ matrix.target }}"
      shell = "bash"
    }
    new {
      name = "Run cargo test with all features in release mode"
      run = "${{ matrix.buildtool }} test --all-targets --workspace --all-features --release --target ${{ matrix.target }}"
      shell = "bash"
    }
  }
} |> Common.standardJobConfig("${{ matrix.os }}", null)
