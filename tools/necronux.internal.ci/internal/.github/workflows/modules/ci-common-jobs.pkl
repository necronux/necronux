@ModuleInfo { minPklVersion = "0.27.0" }
module necronux.internal.ci.ciCommon.jobs

import "../../../../../commons/GitHubAction.pkl" as gha

import "../helpers/Actions.pkl"
import "../helpers/Common.pkl"
import "../helpers/Steps.pkl"

const function typos() = new gha.Job {
  name = "Typos"
  steps {
    Steps.checkout(null)
    new {
      name = "Check for typos"
      uses = Actions.typos
    }
  }
} |> Common.standardJobConfig(null, null)

const function taplo() = new gha.Job {
  name = "Taplofmt"
  steps {
    Steps.checkout(null)
    Steps.installAction("taplo-cli")
    new {
      name = "Run Taplo"
      run = "taplo fmt --check --diff"
      shell = "bash"
    }
  }
} |> Common.standardJobConfig(null, null)
