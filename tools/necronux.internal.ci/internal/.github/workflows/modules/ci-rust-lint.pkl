@ModuleInfo { minPklVersion = "0.27.0" }
module necronux.internal.ci.ciRust.lint

import "../../../../../commons/GitHubAction.pkl" as gha

import "../helpers/Common.pkl"
import "../helpers/Steps.pkl"

const function rustfmt() = new gha.Job {
  name = "Rustfmt"
  steps {
    Steps.checkout(null)
    Steps.setupRustToolchainWithComponent("stable", "rustfmt")
    new {
      name = "Run cargo fmt"
      run = "cargo fmt --all --check"
      shell = "bash"
    }
  }
} |> Common.standardJobConfig(null, null)

const function clippy() = new gha.Job {
  name = "Clippy"
  strategy {
    `fail-fast` = false
    matrix {
      ["os"] {
        "ubuntu-latest"
        "ubuntu-24.04-arm"
        "windows-latest"
        "macos-latest"
        "macos-13"
      }
    }
  }
  steps {
    Steps.checkout(null)
    Steps.setupRustCache()
    Steps.setupRustToolchainWithComponent("stable", "clippy")
    new {
      name = "Run cargo clippy"
      run = "cargo clippy --workspace --all-targets --all-features --no-deps -- -D clippy::all" // temporarily removed -D clippy::cargo
      shell = "bash"
    }
  }
} |> Common.standardJobConfig("${{ matrix.os }}", null)
