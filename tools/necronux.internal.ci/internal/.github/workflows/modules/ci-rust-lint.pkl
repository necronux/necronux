@ModuleInfo { minPklVersion = "0.27.0" }
module CiRustLint

import "../../../../../commons/GitHubAction.pkl" as gha

import "../helpers/Common.pkl"
import "../helpers/Matrices.pkl"
import "../helpers/Steps.pkl"

const function rustfmt() = new gha.Job {
  name = "Rustfmt"
  steps {
    Steps.checkout(null)
    new {
      ...Common.setupRustToolchainCommon("cargo")
      with {
        ["toolchain"] = "stable"
        ["components"] = "rustfmt"
      }
    }
    new {
      name = "Run cargo fmt"
      run = "cargo fmt --all --check"
      shell = "bash"
    }
  }
} |> Common.standardJobConfig(null, null)

const function clippyMinimal() = new gha.Job {
  `if` = "${{ (github.event_name == 'push' || (github.event_name == 'workflow_dispatch' && github.event.inputs.trigger_event == 'push')) && !cancelled() }}"
  name = "Minimal Clippy (${{ matrix.name }})"
  strategy {
    `fail-fast` = false
    matrix {
      ["include"] = (Matrices.rustMatrixClippyMinimal()) {}
    }
  }
  steps {
    Steps.checkout(null)
    Steps.setupRustCache(outer.name)
    new {
      ...Common.setupRustToolchainCommon("cargo")
      with {
        ["toolchain"] = "${{ matrix.toolchain }}"
        ["targets"] = "${{ matrix.target }}"
        ["components"] = "clippy"
      }
    }
    new {
      name = "Run cargo clippy"
      run = "cargo clippy --workspace --all-targets --all-features --no-deps --target ${{ matrix.target }} -- -D clippy::all" // temporarily removed -D clippy::cargo
      shell = "bash"
    }
  }
} |> Common.standardJobConfig("${{ matrix.os }}", null)

const function clippyFull() = new gha.Job {
  `if` = "${{ (github.event_name == 'pull_request' || (github.event_name == 'workflow_dispatch' && github.event.inputs.trigger_event == 'pull_request')) && !cancelled() }}"
  name = "Full Clippy (${{ matrix.name }})"
  strategy {
    `fail-fast` = false
    matrix {
      ["include"] = (Matrices.rustMatrixClippyFull()) {}
    }
  }
  steps {
    Steps.checkout(null)
    Steps.setupRustCache(outer.name)
    new {
      ...Common.setupRustToolchainCommon("cargo")
      with {
        ["toolchain"] = "${{ matrix.toolchain }}"
        ["targets"] = "${{ matrix.target }}"
        ["components"] = "clippy"
      }
    }
    new {
      name = "Run cargo clippy"
      run = "cargo clippy --workspace --all-targets --all-features --no-deps --target ${{ matrix.target }} -- -D clippy::all" // temporarily removed -D clippy::cargo
      shell = "bash"
    }
  }
} |> Common.standardJobConfig("${{ matrix.os }}", null)
