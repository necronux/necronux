@ModuleInfo { minPklVersion = "0.27.0" }
module ReleaseDraftBuild

import "../../../../../commons/GitHubAction.pkl" as gha

import "../helpers/Actions.pkl"
import "../helpers/Common.pkl"
import "../helpers/EnvVars.pkl"
import "../helpers/Matrices.pkl"
import "../helpers/MatricesRust.pkl"
import "../helpers/Steps.pkl"

const function reuseSPDXSBOM() = new gha.Job {
  name = "Generate REUSE SPDX SBOM"
  needs {
    "validate-release-tag"
    "validate-release-type"
  }
  steps {
    Steps.checkoutWithRef(null, "${{ inputs.release_tag }}")
    new {
      name = "REUSE SPDX SBOM"
      uses = Actions.reuseAction
      with {
        ["args"] = "spdx -o reuse.spdx"
      }
    }
    new {
      name = "Upload SBOM"
      uses = Actions.uploadArtifact
      with {
        ["name"] = "sbom-${{ inputs.release_tag }}"
        ["overwrite"] = true
        ["compression-level"] = 9
        ["path"] = "reuse.spdx"
      }
    }
  }
} |> Common.standardJobConfig(null, null)

const function necronux_cli() = new gha.Job {
  name = "Build Necronux CLI App"
  needs {
    "validate-release-tag"
    "validate-release-type"
  }
  strategy {
    `fail-fast` = false
    matrix {
      ["include"] = (Matrices.rustMatrixBuild()) {}
    }
  }
  env = (EnvVars.rustEnvFull) {}
  steps {
    Steps.checkoutWithRef(null, "${{ inputs.release_tag }}")
    Steps.installPodmanAptIf("${{ (matrix.buildtool == 'cross' && (matrix.os == '\(MatricesRust.x86_64_LinuxRunner)' || matrix.os == '\(MatricesRust.aarch64_LinuxRunner)')) }}")
    new {
      `if` = "${{ matrix.buildtool != 'cross' }}"
      ...Common.setupRustToolchainCommon("cargo")
      with {
        ["toolchain"] = "${{ matrix.toolchain }}"
        ["targets"] = "${{ matrix.target }}"
      }
    }
    new {
      `if` = "${{ matrix.buildtool == 'cross' }}"
      ...Common.setupRustToolchainCommon("cross")
      with {
        ["toolchain"] = "${{ matrix.toolchain }}"
      }
    }
    Steps.installActionIf("cross", "${{ matrix.buildtool == 'cross' }}")
    new {
      name = "Build release binary"
      run = "${{ matrix.buildtool }} build --bin necronux --release --locked --workspace --verbose --target-dir ./target/${{ matrix.target }}/"
      shell = "bash"
    }
    new {
      `if` = "${{ matrix.os != '\(MatricesRust.x86_64_WindowsRunner)' }}"
      name = "REUSE SPDX SBOM (Non-Windows)"
      uses = Actions.reuseAction
      with {
        ["args"] = "spdx -o reuse.spdx"
      }
    }
    new {
      `if` = "${{ matrix.os == '\(MatricesRust.x86_64_WindowsRunner)' }}"
      name = "REUSE SPDX SBOM (Windows)"
      run = "pipx run reuse spdx -o reuse.spdx"
      shell = "powershell"
    }
    new {
      name =  "Determine binary path and archive name"
      run = """
      if [[ ${{ matrix.os }} == '\(MatricesRust.x86_64_WindowsRunner)' ]]; then
        bin="target/${{ matrix.target }}/release/necronux.exe"
      else
        bin="target/${{ matrix.target }}/release/necronux"
      fi
      echo "BIN=$bin" >> $GITHUB_ENV
      echo "ARCHIVE=necronux-${{ inputs.release_tag }}-${{ matrix.target }}" >> $GITHUB_ENV
      """
      shell = "bash"
    }
    new {
      name = "Create directory for archive and transfer files"
      run = """
      mkdir -p "$ARCHIVE"/docs
      cp "$BIN" "$ARCHIVE"/
      cp {README.md,COPYRIGHT,THIRD-PARTY-NOTICES,REUSE.toml,reuse.spdx} "$ARCHIVE"/
      cp -r LICENSES/ "$ARCHIVE"/
      cp docs/INSTALL.md "$ARCHIVE"/docs/
      """
      shell = "bash"
    }
    new {
      name = "Build archive (Unix)"
      `if` = "${{ matrix.os != '\(MatricesRust.x86_64_WindowsRunner)' }}"
      run = """
      tar czf "$ARCHIVE.tar.gz" "$ARCHIVE"
      shasum -a 256 "$ARCHIVE.tar.gz" > "$ARCHIVE.tar.gz.sha256"
      echo "ASSET=$ARCHIVE.tar.gz" >> $GITHUB_ENV
      echo "ASSET_SUM=$ARCHIVE.tar.gz.sha256" >> $GITHUB_ENV
      """
      shell = "bash"
    }
    new {
      name = "Build archive (Windows)"
      `if` = "${{ matrix.os == '\(MatricesRust.x86_64_WindowsRunner)' }}"
      run = """
      7z a "$ARCHIVE.zip" "$ARCHIVE"
      certutil -hashfile "$ARCHIVE.zip" SHA256 > "$ARCHIVE.zip.sha256"
      echo "ASSET=$ARCHIVE.zip" >> $GITHUB_ENV
      echo "ASSET_SUM=$ARCHIVE.zip.sha256" >> $GITHUB_ENV
      """
      shell = "bash"
    }
    new {
      name = "Upload tars, zips and sums"
      uses = Actions.uploadArtifact
      with {
        ["name"] = "necronux_cli-${{ inputs.release_tag }}-${{ matrix.target }}"
        ["overwrite"] = true
        ["compression-level"] = 9
        ["path"] = """
        ${{ env.ASSET }}
        ${{ env.ASSET_SUM }}
        """
      }
    }
  }
} |> Common.standardJobConfig("${{ matrix.os }}", null)

const function necronux_stdschema() = new gha.Job {
  name = "Build Necronux Stdschema"
  needs {
    "validate-release-tag"
    "validate-release-type"
  }
  steps {
    Steps.checkoutWithRef(null, "${{ inputs.release_tag }}")
    Steps.installAction("just")
    new {
      name = "Build release package"
      run = "just make-stdschemapkg"
      shell = "bash"
    }
    new {
      name =  "Determine package dir path and archive name"
      run = """
      pkgdir="stdschema/build/generated/pkl/packages"
      echo "PKGDIR=$pkgdir" >> $GITHUB_ENV
      echo "ARCHIVE=necronux-stdschema-${{ inputs.release_tag }}" >> $GITHUB_ENV
      """
      shell = "bash"
    }
    new {
      name = "Create directory for archive and transfer files"
      run = """
      mkdir -p "$ARCHIVE"
      cp "$PKGDIR"/necronux.std.schema@${{ inputs.release_tag }} "$ARCHIVE"/
      cp "$PKGDIR"/necronux.std.schema@${{ inputs.release_tag }}.sha256 "$ARCHIVE"/
      cp "$PKGDIR"/necronux.std.schema@${{ inputs.release_tag }}.zip "$ARCHIVE"/
      cp "$PKGDIR"/necronux.std.schema@${{ inputs.release_tag }}.zip.sha256 "$ARCHIVE"/
      """
      shell = "bash"
    }
    new {
      name = "Upload pkgs, zips and sums"
      uses = Actions.uploadArtifact
      with {
        ["name"] = "necronux_stdschema-${{ inputs.release_tag }}"
        ["overwrite"] = true
        ["compression-level"] = 9
        ["path"] = """
        ${{ env.ARCHIVE }}/necronux.std.schema@${{ inputs.release_tag }}
        ${{ env.ARCHIVE }}/necronux.std.schema@${{ inputs.release_tag }}sha256
        ${{ env.ARCHIVE }}/necronux.std.schema@${{ inputs.release_tag }}.zip
        ${{ env.ARCHIVE }}/necronux.std.schema@${{ inputs.release_tag }}.zip.sha256
        """
      }
    }
  }
} |> Common.standardJobConfig(null, null)
