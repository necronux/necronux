@ModuleInfo { minPklVersion = "0.27.0" }
module necronux.internal.ci.ciPkl

amends "../../../../commons/GitHubAction.pkl"

import "helpers/Common.pkl"
import "helpers/Jobs.pkl"
import "helpers/Steps.pkl"
import "helpers/Triggers.pkl"

headercomment = """
# ==-----------------------------------------------------------== #
# SPDX-FileCopyrightText: © 2025 Nayan Patil <nayantsg@proton.me>
#
# SPDX-License-Identifier: GPL-3.0-or-later
# ==-----------------------------------------------------------== #
"""

name = "CI-Pkl"

on {
  pull_request {
    branches = (Triggers.prBranches()) {}
    paths = (Triggers.pklPaths()) {}
  }
  push {
    paths = (Triggers.pklPaths()) {}
  }
  workflow_dispatch {}
}

concurrency {
  group = "${{ github.workflow }}-${{ github.event.pull_request.number || github.ref }}"
  `cancel-in-progress` = true
}

permissions {
  contents = "write"
}

jobs {
  ["conclusion"] = (Jobs.conclusionAll()) {
    needs {
      "resolvecheck"
      "evalcheck"
      "test"
    }
  }

  ["resolvecheck"] {
    ...Common.standardJobConfig(null, null)
    name = "Resolve Check"
    steps {
      Steps.checkout(null)
      Steps.installAction("just")
      new {
        name = "Check if necronux.std.schema pkl project can be resolved"
        run = "just resolve-stdschemapkl"
        shell = "bash"
      }
      new {
        name = "Check if necronux internal pkl projects can be resolved"
        run = "just resolve-internalpkl"
        shell = "bash"
      }
    }
  }
  ["evalcheck"] {
    ...Common.standardJobConfig(null, null)
    name = "Eval Check"
    steps {
      Steps.checkout(null)
      Steps.installAction("just")
      new {
        name = "Check if necronux.std.schema pkl modules can be evaluated"
        run = "just eval-stdschemapkl"
        shell = "bash"
      }
      new {
        name = "Check if necronux internal pkl modules can be evaluated"
        run = "just eval-internalpkl"
        shell = "bash"
      }
      new {
        name = "Verify necronux internal pkl modules evaluation reflects the latest changes"
        run = "git diff --exit-code"
        shell = "bash"
      }
    }
  }
  ["test"] {
    ...Common.standardJobConfig(null, null)
    name = "Tests"
    steps {
      Steps.checkout(null)
      Steps.installAction("just")
      new {
        name = "Test necronux.std.schema pkl modules"
        run = "just test-stdschemapkl"
        shell = "bash"
      }
    }
  }
}
