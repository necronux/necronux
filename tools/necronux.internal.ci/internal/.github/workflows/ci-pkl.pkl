@ModuleInfo { minPklVersion = "0.27.0" }
module CiPkl

amends "../../../../commons/GitHubAction.pkl"

import "helpers/Common.pkl"
import "helpers/Jobs.pkl"
import "helpers/Triggers.pkl"

import "modules/ci-pkl-jobs.pkl" as CiPklJobs

headercomment = Common.headerComment("2025", "Nayan Patil <nayantsg@proton.me>", "GPL-3.0-or-later")
name = "CI-Pkl"
permissions = (Common.contentPermissions("read")) {}
concurrency = (Common.concurrencyPROrRef()) {}

on {
  pull_request {
    branches = (Triggers.prBranches()) {}
    paths = (Triggers.pklPaths()) {}
  }
  push {
    paths = (Triggers.pklPaths()) {}
  }
  workflow_dispatch {}
}
jobs {
  ["conclusion"] = (Jobs.conclusionAll()) {
    needs {
      "resolvecheck"
      "evalcheck"
      "test"
    }
  }

  ["resolvecheck"] = (CiPklJobs.resolveCheck()) {}
  ["evalcheck"] = (CiPklJobs.evalCheck()) {}
  ["test"] = (CiPklJobs.tests()) {}
}
