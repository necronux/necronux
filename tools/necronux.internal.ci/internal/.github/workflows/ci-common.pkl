@ModuleInfo { minPklVersion = "0.27.0" }
module necronux.internal.ci.ciCommon

amends "../../../../commons/GitHubAction.pkl"

import "helpers/Jobs.pkl"

import "modules/ci-common-jobs.pkl" as CiCommon

headercomment = """
# ==-----------------------------------------------------------== #
# SPDX-FileCopyrightText: © 2025 Nayan Patil <nayantsg@proton.me>
#
# SPDX-License-Identifier: GPL-3.0-or-later
# ==-----------------------------------------------------------== #
"""

name = "CI-Common"

on {
  pull_request {}
  push {}
  workflow_dispatch {}
}

concurrency {
  group = "${{ github.workflow }}-${{ github.event.pull_request.number || github.ref }}"
  `cancel-in-progress` = true
}

permissions {
  contents = "read"
}

jobs {
  ["conclusion"] = (Jobs.conclusionAll()) {
    needs {
      "typos"
      "taplo"
    }
  }

  ["typos"] = (CiCommon.typos()) {}
  ["taplo"] = (CiCommon.taplo()) {}
}
