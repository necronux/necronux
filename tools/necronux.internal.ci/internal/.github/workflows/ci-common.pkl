@ModuleInfo { minPklVersion = "0.27.0" }
module necronux.internal.ci.ciCommon

amends "../../../../commons/GitHubAction.pkl"

import "helpers/Actions.pkl"
import "helpers/Common.pkl"
import "helpers/Jobs.pkl"
import "helpers/Steps.pkl"

headercomment = """
# ==-----------------------------------------------------------== #
# SPDX-FileCopyrightText: © 2025 Nayan Patil <nayantsg@proton.me>
#
# SPDX-License-Identifier: GPL-3.0-or-later
# ==-----------------------------------------------------------== #
"""

name = "CI-Common"

on {
  pull_request {}
  push {}
  workflow_dispatch {}
}

concurrency {
  group = "${{ github.workflow }}-${{ github.event.pull_request.number || github.ref }}"
  `cancel-in-progress` = true
}

permissions {
  contents = "read"
}

jobs {
  ["conclusion"] = (Jobs.conclusionAll()) {
    needs {
      "typos"
      "taplo"
    }
  }

  ["typos"] {
    ...Common.standardJobConfig(null, null)
    name = "Typos"
    steps {
      Steps.checkout(null)
      new {
        name = "Check for typos"
        uses = Actions.typos
      }
    }
  }
  ["taplo"] {
    ...Common.standardJobConfig(null, null)
    name = "Taplofmt"
    steps {
      Steps.checkout(null)
      Steps.installAction("taplo-cli")
      new {
        name = "Run Taplo"
        run = "taplo fmt --check --diff"
        shell = "bash"
      }
    }
  }
}
