@ModuleInfo { minPklVersion = "0.27.0" }
module necronux.internal.ci.ciRust

amends "../../../../commons/GitHubAction.pkl"

import "helpers/Common.pkl"
import "helpers/EnvVars.pkl"
import "helpers/Jobs.pkl"
import "helpers/Triggers.pkl"

import "modules/ci-rust-docs.pkl" as Docs
import "modules/ci-rust-lint.pkl" as Lint
import "modules/ci-rust-test.pkl" as Test
import "modules/ci-rust-version.pkl" as Version

headercomment = Common.headerComment("2024-2025", "Nayan Patil <nayantsg@proton.me>", "GPL-3.0-or-later")
name = "CI-Rust"
permissions = (Common.contentPermissions("read")) {}
concurrency = (Common.concurrencyPROrRef()) {}
env = (EnvVars.rustEnvFull) {}

on {
  pull_request {
    branches = (Triggers.prBranches()) {}
    paths = (Triggers.rustPaths()) {}
  }
  push {
    paths = (Triggers.rustPaths()) {}
  }
  workflow_dispatch {
    inputs {
      ["trigger_event"] = (Triggers.wDispatchEventSim()) {}
    }
  }
}
jobs {
  ["conclusion-pr"] = (Jobs.conclusionPR()) {
    needs = (jobs["conclusion-push"].needs) {
      [0] = "test-full"
      [1] = "clippy-full"
    }
  }
  ["conclusion-push"] = (Jobs.conclusionPush()) {
    needs {
      "test-minimal"
      "clippy-minimal"
      "check-version-bump"
      "docs"
      "lockfile"
      "msrv"
      "rustfmt"
    }
  }

  ["rustfmt"] = (Lint.rustfmt()) {}
  ["clippy-minimal"] = (Lint.clippyMinimal()) {}
  ["clippy-full"] = (Lint.clippyFull()) {}
  ["lockfile"] = (Version.lockfile()) {}
  ["check-version-bump"] = (Version.checkVersionBump()) {}
  ["test-minimal"] = (Test.testMinimal()) {}
  ["test-full"] = (Test.testFull()) {}
  ["docs"] = (Docs.docs()) {}
  ["msrv"] = (Version.msrv()) {}
}
