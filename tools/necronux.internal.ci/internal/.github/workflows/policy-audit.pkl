@ModuleInfo { minPklVersion = "0.27.0" }
module necronux.internal.ci.policyAudit

amends "../../../../commons/GitHubAction.pkl"

import "helpers/Actions.pkl"
import "helpers/Common.pkl"
import "helpers/Steps.pkl"
import "helpers/Triggers.pkl"

headercomment = """
# ==-----------------------------------------------------------== #
# SPDX-FileCopyrightText: © 2025 Nayan Patil <nayantsg@proton.me>
#
# SPDX-License-Identifier: GPL-3.0-or-later
# ==-----------------------------------------------------------== #
"""

name = "Security audit"

permissions {
  contents = "read"
}

on {
  pull_request {
    paths = (Triggers.rustPaths()) {}
  }
  push {
    paths = (Triggers.rustPaths()) {}
  }
  workflow_dispatch {}
}

jobs {
  ["cargo_deny"] {
    ...Common.standardJobConfig(null, null)
    name = "Cargo Deny"
    steps {
      Steps.checkout(null)
      new {
        name = "Run cargo deny check without advisories"
        uses = Actions.cargoDenyAction
        with {
          ["command"] = "check bans licenses sources"
          ["rust-version"] = "stable"
        }
      }
      new {
        name = "Run cargo deny check advisories"
        // Prevent sudden announcement of a new advisory from failing ci:
        run = "cargo cargo-deny check advisories || { echo 'Advisories check failed, but continuing the workflow...'; exit 0; }"
        shell = "bash"
      }
    }
  }
}
