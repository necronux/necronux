    StepsCommon.installPodmanAptIf("${{ (matrix.buildtool == 'cross' && (matrix.os == '\(MatricesRust.x86_64_LinuxRunner)' || matrix.os == '\(MatricesRust.aarch64_LinuxRunner)')) }}")
    new {
      `if` = "${{ matrix.buildtool != 'cross' }}"
      ...UtilsCommon.setupRustToolchainCommon("cargo")
      with {
        ["toolchain"] = "${{ matrix.toolchain }}"
