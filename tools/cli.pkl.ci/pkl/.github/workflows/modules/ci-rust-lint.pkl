    matrix {
      ["include"] = (MatricesRust.rustMatrixClippyBuild()) {}
    }
  }
  steps {
    StepsCommon.checkout(null)
    StepsRust.setupRustCacheWithSharedKey("[clippy-${{ matrix.name }}]", false)
    new {
      ...UtilsCommon.setupRustToolchainCommon("cargo")
      with {
        ["toolchain"] = "${{ matrix.toolchain }}"
