const function clippyAllFull() = new gha.Job {
  name = "Clippy All Full (${{ matrix.name }})"
  strategy {
    `fail-fast` = false
    matrix {
      ["include"] = (MatricesRust.rustMatrixClippyFull()) {}
    }
  }
  steps {
    StepsCommon.checkout(null)
    StepsRust.setupRustCacheWithSharedKey("[clippy-${{ matrix.name }}]", "${{ github.ref == 'refs/heads/develop' }}")
    new {
      ...UtilsCommon.setupRustToolchainCommon("cargo")
      with {
        ["toolchain"] = "${{ matrix.toolchain }}"
        ["components"] = "clippy"
        ["targets"] = "${{ matrix.target }}"
