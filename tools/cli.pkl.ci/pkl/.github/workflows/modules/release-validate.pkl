@ModuleInfo { minPklVersion = "0.27.0" }
module ReleaseValidate

import "@internal/schemas/GitHubAction.pkl" as gha

import "@internal/gha/StepsCommon.pkl"
import "@internal/gha/UtilsCommon.pkl"

const function releaseTag() = new gha.Job {
  name = "Validate Release Tag"
  steps {
    StepsCommon.checkoutWithRef(0, "${{ inputs.release_tag }}")
    new {
      name = "Display release tag"
      run = """
      echo "Release tag: ${{ inputs.release_tag }}"
      TAG="${{ inputs.release_tag }}"
      VERSION="${TAG#*v}"
      echo "Release Version: $VERSION"
      echo "RELEASE_VERSION=$VERSION" >> "$GITHUB_ENV"
      """
      shell = "bash"
    }
    new {
      name = "Check that tag version and Cargo.toml version are the same"
      run = """
      TAG_VERSION="${{ env.RELEASE_VERSION }}"
      ROOT_PKG_VERSION=$(awk '/\\[package\\]/ {p=1} p && /^version =/ {gsub(/"/, "", $3); print $3; exit}' Cargo.toml)
      WORKSPACE_PKG_VERSION=$(awk '/\\[workspace\\.package\\]/ {p=1} p && /^version =/ {gsub(/"/, "", $3); print $3; exit}' Cargo.toml)
      echo "Extracted [package] version: '$ROOT_PKG_VERSION'"
      echo "Extracted [workspace.package] version: '$WORKSPACE_PKG_VERSION'"
      if [ "$TAG_VERSION" != "$ROOT_PKG_VERSION" ]; then
        echo "Error: Tag version ("$TAG_VERSION") does not match root Cargo.toml version ("$ROOT_PKG_VERSION")"
        exit 1
      fi
      if [ "$TAG_VERSION" != "$WORKSPACE_PKG_VERSION" ]; then
        echo "Error: Tag version ("$TAG_VERSION") does not match root Cargo.toml version ("$WORKSPACE_PKG_VERSION")"
        exit 1
      fi
      """
      shell = "bash"
    }
  }
} |> UtilsCommon.standardJobConfig(null, null)
