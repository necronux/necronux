@ModuleInfo { minPklVersion = "0.27.0" }
module common

import "../../../../../commons/GitHubAction.pkl" as gha

const function standardJobConfig() = new {
  `runs-on` = new gha.UbuntuLatest {}
  `timeout-minutes` = 30
}

const rustEnv: gha.EnvironmentVariables = new  {
  ["CARGO_INCREMENTAL"] = 0
  ["CARGO_NET_RETRY"] = 10
  ["CARGO_TERM_COLOR"] = "always"
  ["RUST_BACKTRACE"] = 1
  ["RUSTFLAGS"] = "-D warnings"
  ["RUSTUP_MAX_RETRIES"] = 10
  ["CARGO_HACK_DENY_WARNINGS"] = 1
}

const function setupRustupStable(): gha.Step = new {
  name = "Setup rustup stable"
  run = "rustup update --no-self-update stable"
  shell = "bash"
}
const function updateRustup(): gha.Step = new {
  name = "Update rustup and set default version"
  run = "rustup update --no-self-update ${{ matrix.rust }} && rustup default ${{ matrix.rust }}"
  shell = "bash"
}
const function rustupTargetAdd(): gha.Step = new {
  `if` = "${{ matrix.other != null }}"
  name = "Add rustup targets"
  run = "rustup target add ${{ matrix.other }}"
  shell = "bash"
}
const function configExtra(): gha.Step = new {
  name = "Configure extra test environment"
  `if`= "matrix.os == 'ubuntu-latest'"
  run = "echo CARGO_CONTAINER_TESTS=1 >> $GITHUB_ENV"
  shell = "bash"
}
const function rustupAndConfigExtra() = new {
  setupRustupStable()
  updateRustup()
  rustupTargetAdd()
  configExtra()
}

const function rustMatrix() = new Listing {
  new {
    name = "Linux x86_64 stable"
    os = "ubuntu-latest"
    rust = "stable"
    other = "i686-unknown-linux-gnu"
  }
  new {
    name = "Linux x86_64 beta"
    os = "ubuntu-latest"
    rust = "beta"
    other = "i686-unknown-linux-gnu"
  }
  new {
    name = "Linux x86_64 nightly"
    os = "ubuntu-latest"
    rust = "nightly"
    other = "i686-unknown-linux-gnu"
  }
  new {
    name = "Linux aarch64 stable"
    os = "ubuntu-24.04-arm"
    rust = "stable"
  }
  new {
    name = "Linux aarch64 nightly"
    os = "ubuntu-24.04-arm"
    rust = "nightly"
  }
  new {
    name = "Windows x86_64 MSVC stable"
    os = "windows-latest"
    rust = "stable-msvc"
    other = "i686-pc-windows-msvc"
  }
  new {
    name = "Windows x86_64 gnu nightly"
    os = "windows-latest"
    rust = "nightly-gnu"
    other = "i686-pc-windows-gnu"
  }
  new {
    name = "macOS aarch64 stable"
    os = "macos-latest"
    rust = "stable"
    other = "x86_64-apple-darwin"
  }
  new {
    name = "macOS aarch64 nightly"
    os = "macos-latest"
    rust = "nightly"
    other = "x86_64-apple-darwin"
  }
  new {
    name = "macOS x86_64 nightly"
    os = "macos-13"
    rust = "nightly"
  }
}

