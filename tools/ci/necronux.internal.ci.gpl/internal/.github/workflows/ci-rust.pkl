@ModuleInfo { minPklVersion = "0.27.0" }
module ciRust

amends "../../../../commons/GitHubAction.pkl"

import "helpers/Common.pkl"
import "helpers/Jobs.pkl"
import "helpers/Steps.pkl"
import "helpers/Triggers.pkl"

import "modules/ci-rust-lint.pkl" as Lint
import "modules/ci-rust-test.pkl" as Test
import "modules/ci-rust-version.pkl" as Version

headercomment = """
# ==----------------------------------------------------------------== #
# SPDX-FileCopyrightText: © 2024-2025 Nayan Patil <nayantsg@proton.me>
#
# SPDX-License-Identifier: GPL-3.0-or-later
# ==----------------------------------------------------------------== #
"""

name = "CI-Rust"

on {
  pull_request {
    branches = (Triggers.prBranches()) {}
    paths = (Triggers.rustPaths()) {}
  }
  push {
    paths = (Triggers.rustPaths()) {}
  }
  workflow_dispatch {
    inputs {
      ["trigger_event"] = (Triggers.wDispatchEventSim()) {}
    }
  }
}

env {
  ["CARGO_INCREMENTAL"] = 0
  ["CARGO_NET_RETRY"] = 10
  ["CARGO_TERM_COLOR"] = "always"
  ["RUST_BACKTRACE"] = 1
  ["RUSTFLAGS"] = "-D warnings"
  ["RUSTUP_MAX_RETRIES"] = 10
  ["CARGO_HACK_DENY_WARNINGS"] = 1
}

concurrency {
  group = "${{ github.workflow }}-${{ github.event.pull_request.number || github.ref }}"
  `cancel-in-progress` = true
}

permissions {
  contents = "read"
}

jobs {
  ["conclusion-pr"] = (Jobs.conclusionPR()) {
    needs = (jobs["conclusion-push"].needs) {
      [0] = "test-full"
    }
  }
  ["conclusion-push"] = (Jobs.conclusionPush()) {
    needs {
      "test-minimal"
      "check-version-bump"
      "clippy"
      "docs"
      "lockfile"
      "msrv"
      "rustfmt"
    }
  }

  ["rustfmt"] = (Lint.rustfmt()) {}
  ["clippy"] = (Lint.clippy()) {}

  ["lockfile"] = (Version.lockfile()) {}
  ["check-version-bump"] = (Version.checkVersionBump()) {}

  ["test-minimal"] = (Test.testMinimal()) {}
  ["test-full"] = (Test.testFull()) {}

  ["docs"] {
    name = "Docs"
    ...Common.standardJobConfig()
    env = (module.env) {
      ["RUSTFLAGS"] = "-C debuginfo=0 -D warnings"
    }
    steps {
      Steps.checkout(null)
      Steps.setupRustCache()
      Steps.setupRustToolchain("stable")
      new {
        name = "Run cargo doc"
        run = "cargo doc --workspace --all-features --no-deps --document-private-items --keep-going"
        shell = "bash"
        env {
          ["RUSTDOCFLAGS"] = "-D warnings"
        }
      }
      new {
        name = "Run cargo test with all features in debug mode"
        run = "cargo test --doc --workspace --all-features"
        shell = "bash"
      }
    }
  }

  ["msrv"] = (Version.msrv()) {}
}
