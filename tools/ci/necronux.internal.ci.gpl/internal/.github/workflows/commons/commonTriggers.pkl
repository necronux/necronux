@ModuleInfo { minPklVersion = "0.27.0" }

amends "../../../../../commons/GitHubAction.pkl"

// Placeholder name to satisfy type-checking
name = "Common Triggers"

on {
  workflow_dispatch {
    inputs {
      ["trigger_event"] {
        description = "Specify which event to simulate"
        required = false
        default = "push"
        type = "choice"
        options {
          "pull_request"
          "push"
        }
      }
    }
  }
}

jobs {
  // Placeholder job to satisfy type-checking
  ["Step"] {
    `runs-on` = "ubuntu-latest"
    steps {
      new {
        name = "Use Step"
        uses = "actions/checkout@v4"
      }
    }
  }
}
