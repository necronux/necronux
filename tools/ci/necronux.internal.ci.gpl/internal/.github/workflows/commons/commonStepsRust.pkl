@ModuleInfo { minPklVersion = "0.27.0" }

amends "../../../../../commons/GitHubAction.pkl"

// Placeholder name to satisfy type-checking
name = "Common Steps Rust"

// Placeholder trigger to satisfy type-checking
on {
  workflow_dispatch {}
}

jobs {
  // Placeholder job to satisfy type-checking
  ["setupRustToolchainStep"] {
    `runs-on` = "ubuntu-latest"
    steps {
      new {
        name = "Setup rust toolchain"
        uses = "dtolnay/rust-toolchain@master"
        with {
          ["toolchain"] = "stable"
        }
      }
    }
  }
  // Placeholder job to satisfy type-checking
  ["setupRustCacheStep"] {
    `runs-on` = "ubuntu-latest"
    steps {
      new {
        name = "Setup rust cache"
        uses = "Swatinem/rust-cache@v2"
        with {
          ["save-if"] = "${{ github.ref == 'refs/heads/develop' || startsWith(github.ref, 'refs/heads/release/v') }}"
        }
      }
    }
  }
}
