@ModuleInfo { minPklVersion = "0.27.0" }

amends "../../../../commons/GitHubAction.pkl"

headercomment = """
# ==----------------------------------------------------------------== #
# SPDX-FileCopyrightText: © 2024-2025 Nayan Patil <nayantsg@proton.me>
#
# SPDX-License-Identifier: Apache-2.0
# ==----------------------------------------------------------------== #
"""

name = "Branch Protection"

on {
  pull_request {}
}

permissions {
  contents = "read"
}

jobs {
  ["protect-stable-branch"] {
    `runs-on` = "ubuntu-latest"
    steps {
      new {
        name = "Checkout code"
        uses = "actions/checkout@v4"
        with {
         ["fetch-depth"] = 0
        }
      }
      new {
        name = "Ensure PRs are only from allowed branches"
        run = "tools/ci/scripts/protect-develop-branch.sh"
      }
    }
  }
}
